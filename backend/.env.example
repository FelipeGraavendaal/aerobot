# --- LLM (Anthropic) ---------------------------------------------------
# Sin key, AeroBot arranca en "modo demo" con un LLM simulado.
ANTHROPIC_API_KEY=
# Usa el modelo Claude más reciente disponible en tu cuenta.
ANTHROPIC_MODEL=claude-sonnet-4-5
AEROBOT_MAX_TOKENS=2048
AEROBOT_MAX_ITERATIONS=6
AEROBOT_FORCE_MOCK_LLM=0

# --- APIs meteorológicas (todas opcionales) ------------------------------
# Open-Meteo gratuito comparte cuota por IP; con key comercial se evita el 429.
OPEN_METEO_API_KEY=
# Respaldo de METAR si AviationWeather.gov falla.
CHECKWX_API_KEY=
# 1 = si una API falla, las tools devuelven datos simulados marcados source="mock".
AEROBOT_ALLOW_MOCK_FALLBACK=1
AEROBOT_HTTP_TIMEOUT=12

# --- Servidor ----------------------------------------------------------
AEROBOT_CORS_ORIGINS=*
AEROBOT_MAX_HISTORY=30
